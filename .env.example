# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env  (it is in .gitignore).
# Every value is whitespace-stripped on load, so a trailing newline from a
# copy/paste is harmless.
# ---------------------------------------------------------------------------

# --- Alpaca PAPER trading (one set of keys per team member) -----------------
# Get these from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_1=
ALPACA_SECRET_KEY_1=
ALPACA_API_KEY_2=
ALPACA_SECRET_KEY_2=
ALPACA_API_KEY_3=
ALPACA_SECRET_KEY_3=

# Single-student convenience fallback (used when the per-student vars are unset)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper endpoint. Must be exactly https://paper-api.alpaca.markets  —
# the paper-trading guard parses the hostname and refuses anything else.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- LLM provider -----------------------------------------------------------
# LLM_PROVIDER: ollama_cloud | ollama_local | groq | openai_compatible | none
LLM_PROVIDER=ollama_cloud

# Ollama Cloud (CI path: OpenAI-compatible endpoint, no browser needed)
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_LOCAL_BASE_URL=http://localhost:11434/v1
# Plain model id for the cloud endpoint, e.g. gpt-oss:120b / qwen3-coder:480b
# For the LOCAL daemon path append -cloud, e.g. gpt-oss:120b-cloud
LLM_MODEL=gpt-oss:120b

# Groq (OpenAI-compatible base URL — do NOT use litellm's "groq/" prefix)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Any other OpenAI-compatible endpoint
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- Run behaviour ----------------------------------------------------------
# analyse = produce recommendations only; execute = also submit paper orders
RUN_MODE=analyse
# true  -> orders are NEVER auto-submitted (default, safe)
# false -> orders submitted automatically (set only by mode=execute in CI)
REQUIRE_HUMAN_APPROVAL=true
# Clearly-labelled synthetic data. Without credentials AND without demo mode
# the system REFUSES to fetch rather than inventing prices.
DEMO_MODE=false
# How many symbols reach the LLM crew (free tiers cap tokens/minute).
# Crew cost is roughly 2 requests per symbol + 4.
MAX_LLM_SYMBOLS=12
# 0.0 = timid, 1.0 = maximum aggression. See README.
AGGRESSION=0.75
CONFIG_PATH=config/config.yaml
